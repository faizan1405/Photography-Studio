# ==========================================
# Cloudflare R2 — Image Storage
# ==========================================

# Cloudflare Account ID (found in R2 dashboard URL: https://dash.cloudflare.com/<ACCOUNT_ID>#r2)
R2_ACCOUNT_ID=

# R2 API Token credentials (found in Cloudflare dashboard → R2 → Manage R2 API Tokens)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Bucket name
R2_BUCKET=website-images

# Public base URL for reading images (your R2 custom domain or R2 public bucket URL)
# Examples:
#   https://images.clickographers.com
#   https://pub-xxxxxxxxxxxxx.r2.dev
VITE_R2_PUBLIC_BASE_URL=

# ==========================================
# Admin Authentication
# ==========================================
# These are SERVER-ONLY variables. Never prefix with VITE_.

# Admin username for /admin login
ADMIN_USERNAME=

# Password hash generated with scrypt. Generate with:
#   node -e "const crypto=require('crypto');const p='your-password';const s=crypto.randomUUID().replace(/-/g,'');crypto.scrypt(p,s,64,(e,h)=>{if(e)throw e;console.log('ADMIN_PASSWORD_HASH=scrypt:'+s+':'+h.toString('hex'));});"
ADMIN_PASSWORD_HASH=

# Session signing secret — generate a long random string (min 32 chars).
# Generate with:
#   node -e "console.log('ADMIN_SESSION_SECRET=' + require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=

# Optional: custom session cookie name (default: admin_session)
ADMIN_SESSION_COOKIE=
